#!/usr/bin/env bash
set -euo pipefail

# get-secret: Extract a single value from an Ansible Vault encrypted YAML file.
# Usage: get-secret <key> [vault-file]

if [[ $# -lt 1 ]]; then
  echo "Usage: get-secret <key> [vault-file]" >&2
  exit 1
fi

key="$1"
vault_file="${2:-}"

# Locate vault password file
vault_pass_file="${ANSIBLE_VAULT_PASSWORD_FILE:-${HOME}/.vault_pass}"
if [[ ! -f "$vault_pass_file" ]]; then
  echo "Error: vault password file not found: $vault_pass_file" >&2
  exit 1
fi

# Locate vault file
if [[ -z "$vault_file" ]]; then
  if [[ -f "secrets.vault.yml" ]]; then
    vault_file="secrets.vault.yml"
  elif [[ -n "${DOTFILES_VAULT:-}" && -f "$DOTFILES_VAULT" ]]; then
    vault_file="$DOTFILES_VAULT"
  else
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if [[ -n "$repo_root" && -f "${repo_root}/secrets.vault.yml" ]]; then
      vault_file="${repo_root}/secrets.vault.yml"
    fi
  fi
fi

if [[ -z "$vault_file" || ! -f "$vault_file" ]]; then
  echo "Error: vault file not found: ${vault_file:-secrets.vault.yml}" >&2
  exit 1
fi

# Decrypt and extract the requested key
# Unset env var to avoid duplicate vault-id conflict with --vault-password-file
unset ANSIBLE_VAULT_PASSWORD_FILE 2>/dev/null || true
ansible-vault decrypt --vault-password-file "$vault_pass_file" --output - "$vault_file" 2>/dev/null \
  | grep "^${key}:" \
  | sed 's/^[^:]*: *//; s/^"//; s/"$//' \
  | tr -d '\n'
